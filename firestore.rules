rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ردود تأكيد الحضور
    match /rsvps/{id} {

      // أي زائر يقدر "يضيف" رد جديد بس — بشروط صارمة على شكل البيانات
      allow create: if request.resource.data.keys().hasOnly(['name', 'attending', 'guests', 'message', 'lang', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.attending is bool
        && request.resource.data.guests is int
        && request.resource.data.guests >= 0
        && request.resource.data.guests <= 10
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.lang in ['ar', 'en']
        && request.resource.data.createdAt == request.time;

      // القراءة والحذف للعريس فقط (غيّر الإيميل ده لإيميل جوجل بتاعك)
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'PUT-YOUR-GMAIL-HERE@gmail.com'
        && request.auth.token.email_verified == true;

      // ممنوع التعديل لأي حد
      allow update: if false;
    }
  }
}
